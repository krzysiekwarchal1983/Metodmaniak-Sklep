# Public Clerk key is embedded in the built frontend.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
VITE_CLERK_PROXY_URL=
# Runtime secrets: configure in Google Secret Manager, not in this file.
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# GCS paths are bucket-name/prefix. Keep uploaded private objects separate from public media.
PRIVATE_OBJECT_DIR=/YOUR_GCS_BUCKET/private
PUBLIC_OBJECT_SEARCH_PATHS=/YOUR_GCS_BUCKET/public
NODE_ENV=production
PORT=8080
BASE_PATH=/
