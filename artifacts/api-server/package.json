{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:preview-admin": "NODE_ENV=development tsx --test src/lib/preview-admin.test.ts src/tests/preview-session.test.ts",
    "test:admin-auth": "NODE_ENV=development tsx --test src/tests/admin-auth.test.ts",
    "test:color-photo": "NODE_ENV=development tsx --test src/tests/color-photo.test.ts",
    "test:metodapka": "tsx --test src/lib/metodapka.test.ts",
    "test:directory": "NODE_ENV=development tsx --test src/lib/fishing-directory.test.ts src/tests/fishing-directory.test.ts",
    "test:stock": "NODE_ENV=development tsx --test src/tests/bulk-stock.test.ts",
    "test:stock-history": "NODE_ENV=development tsx --test src/tests/stock-history.test.ts src/tests/stock-history-export.test.ts",
    "benchmark:stock-export": "node --expose-gc --import tsx src/scripts/benchmark-stock-export.ts",
    "seed": "tsx src/seed.ts",
    "wafters:replace": "tsx src/scripts/replace-wafters.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "google-auth-library": "^11.3.3",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
